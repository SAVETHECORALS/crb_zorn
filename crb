#!/usr/bin/env bash
#
# crb - Cloud Remote Builder & Thin-Client CLI for Xiaomi zorn (LineageOS 24.0 / Android 17)
#

set -e

DEVICE_IP="192.168.0.101:5555"
WORKFLOW_FILE="build.yml"
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

function log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

function log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

function log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

function log_err() {
    echo -e "${RED}[ERROR]${NC} $1"
}

function print_usage() {
    echo -e "${GREEN}crb - Xiaomi zorn (Android 17) Cloud Remote Builder & Hot-Patcher${NC}"
    echo ""
    echo "Usage: ./crb <command> [arguments]"
    echo ""
    echo "Cloud CI Commands (GitHub Actions):"
    echo "  build <target> [module]   Trigger remote cloud build on GitHub Actions"
    echo "                            Targets: sepolicy | bootimage | module | rom"
    echo "                            Example: ./crb build bootimage"
    echo "                            Example: ./crb build module libgui_shim"
    echo "  status                    List recent cloud build runs and their status"
    echo "  logs [run-id]             View live/recent workflow logs"
    echo "  download [run-id]         Download compiled artifacts from cloud to ./artifacts/"
    echo ""
    echo "Device Hot-Patching & Debugging (Wi-Fi ADB Root: $DEVICE_IP):"
    echo "  connect                   Connect to device over Wi-Fi ADB and check root"
    echo "  push <local> <remote>     Push updated file/library directly to device & restart"
    echo "                            Example: ./crb push libgui_shim.so /vendor/lib64/"
    echo "  flash <boot|all>          Flash downloaded boot.img / images via fastboot"
    echo "  logcat [filter]           Stream filtered live device logs over Wi-Fi ADB"
    echo "  shell                     Open interactive root shell on device"
    echo ""
}

function ensure_gh_auth() {
    if ! command -v gh &> /dev/null; then
        log_err "GitHub CLI ('gh') is not installed. Please install it first."
        exit 1
    fi
    if ! gh auth status &> /dev/null; then
        log_err "GitHub CLI is not logged in. Run 'gh auth login' first."
        exit 1
    fi
}

function ensure_adb_connect() {
    log_info "Verifying Wi-Fi ADB connection to $DEVICE_IP..."
    adb connect "$DEVICE_IP" &> /dev/null || true
    local dev_status=$(adb devices | grep "$DEVICE_IP" | awk '{print $2}')
    if [ "$dev_status" != "device" ]; then
        log_warn "Device is not connected at $DEVICE_IP. Retrying..."
        adb disconnect "$DEVICE_IP" &> /dev/null || true
        adb connect "$DEVICE_IP"
    fi
    local root_id=$(adb -s "$DEVICE_IP" shell id -u 2>/dev/null || echo "failed")
    if [ "$root_id" = "0" ]; then
        log_success "Connected to $DEVICE_IP as ROOT (uid=0)."
    else
        log_info "Elevating to ADB root..."
        adb -s "$DEVICE_IP" root || true
    fi
}

COMMAND="$1"
shift || true

case "$COMMAND" in
    build)
        TARGET="${1:-bootimage}"
        MODULE="${2:-libgui_shim}"
        ensure_gh_auth
        
        log_info "Triggering GitHub Actions build for target: '$TARGET'..."
        if [ "$TARGET" = "module" ]; then
            gh workflow run "$WORKFLOW_FILE" -f target="$TARGET" -f module_name="$MODULE"
        else
            gh workflow run "$WORKFLOW_FILE" -f target="$TARGET"
        fi
        
        log_success "Build triggered! Checking status..."
        sleep 3
        gh run list --workflow="$WORKFLOW_FILE" --limit 3
        echo ""
        log_info "To stream logs in real-time, run: ./crb logs"
        ;;

    status)
        ensure_gh_auth
        log_info "Recent GitHub Actions build runs:"
        gh run list --workflow="$WORKFLOW_FILE" --limit 8
        ;;

    logs)
        ensure_gh_auth
        RUN_ID="$1"
        if [ -z "$RUN_ID" ]; then
            RUN_ID=$(gh run list --workflow="$WORKFLOW_FILE" --limit 1 --json databaseId -q '.[0].databaseId')
        fi
        log_info "Streaming logs for Run ID: $RUN_ID..."
        gh run view "$RUN_ID" --log
        ;;

    download)
        ensure_gh_auth
        RUN_ID="$1"
        mkdir -p "$PROJECT_DIR/artifacts"
        if [ -z "$RUN_ID" ]; then
            RUN_ID=$(gh run list --workflow="$WORKFLOW_FILE" --limit 1 --json databaseId -q '.[0].databaseId')
        fi
        log_info "Downloading artifacts for Run ID: $RUN_ID into ./artifacts/..."
        gh run download "$RUN_ID" --dir "$PROJECT_DIR/artifacts"
        log_success "Artifacts saved:"
        ls -la "$PROJECT_DIR/artifacts"
        ;;

    connect)
        ensure_adb_connect
        ;;

    push)
        LOCAL_FILE="$1"
        REMOTE_PATH="$2"
        if [ -z "$LOCAL_FILE" ] || [ -z "$REMOTE_PATH" ]; then
            log_err "Usage: ./crb push <local_file> <remote_path>"
            exit 1
        fi
        ensure_adb_connect
        log_info "Remounting /vendor /system with rw permissions..."
        adb -s "$DEVICE_IP" shell "su -c 'mount -o remount,rw /' || su -c 'mount -o remount,rw /vendor' || true"
        log_info "Pushing $LOCAL_FILE -> $REMOTE_PATH on device..."
        adb -s "$DEVICE_IP" push "$LOCAL_FILE" "$REMOTE_PATH"
        adb -s "$DEVICE_IP" shell "su -c 'chmod 644 $REMOTE_PATH && chown root:root $REMOTE_PATH'"
        log_success "Successfully hot-pushed $LOCAL_FILE to $REMOTE_PATH!"
        log_info "If replacing a HAL or service, restart it with: ./crb shell 'pkill -f <name>'"
        ;;

    flash)
        FLASH_TARGET="${1:-boot}"
        log_info "Checking fastboot device..."
        if [ "$FLASH_TARGET" = "boot" ]; then
            BOOT_IMG="$PROJECT_DIR/artifacts/boot.img"
            DTBO_IMG="$PROJECT_DIR/artifacts/dtbo.img"
            VENDOR_BOOT_IMG="$PROJECT_DIR/artifacts/vendor_boot.img"
            
            if [ ! -f "$BOOT_IMG" ]; then
                log_err "boot.img not found in ./artifacts/. Run './crb download' first."
                exit 1
            fi
            log_info "Flashing boot images via fastboot..."
            fastboot flash boot "$BOOT_IMG"
            [ -f "$VENDOR_BOOT_IMG" ] && fastboot flash vendor_boot "$VENDOR_BOOT_IMG"
            [ -f "$DTBO_IMG" ] && fastboot flash dtbo "$DTBO_IMG"
            log_success "Boot images flashed successfully! Rebooting..."
            fastboot reboot
        fi
        ;;

    logcat)
        FILTER="${1:-zorn|hal|xiaomi|denied|fatal}"
        ensure_adb_connect
        log_info "Streaming logcat matching filter: '$FILTER'..."
        adb -s "$DEVICE_IP" logcat -v color | grep -E --line-buffered "$FILTER"
        ;;

    shell)
        ensure_adb_connect
        adb -s "$DEVICE_IP" shell
        ;;

    *)
        print_usage
        ;;
esac
