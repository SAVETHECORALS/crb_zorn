#!/usr/bin/env bash
#
# crb - Cloud Remote Builder & Flashing CLI for Xiaomi zorn (LineageOS 24.0 / Android 17)
#

set -e

WORKFLOW_FILE="build.yml"
CIRCLE_PROJECT_SLUG="gh/SAVETHECORALS/crb_zorn"
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ARTIFACTS_DIR="$PROJECT_DIR/artifacts"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

function log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

function log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

function log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

function log_err() {
    echo -e "${RED}[ERROR]${NC} $1"
}

function print_usage() {
    echo -e "${GREEN}crb - Xiaomi zorn (Android 17) Cloud Remote Builder & Fastboot Flasher${NC}"
    echo ""
    echo "Usage: ./crb <command> [arguments]"
    echo ""
    echo "GitHub Actions CI Commands:"
    echo "  build [target]            Trigger remote build on GitHub Actions (default: rom)"
    echo "                            Targets: rom | bootimage | recoveryimage | sepolicy"
    echo "  status                    List recent GitHub Actions runs"
    echo "  watch [run-id]            Watch real-time live step progress of a GitHub Actions run"
    echo "  logs [run-id]             Stream/view GitHub Actions build logs"
    echo "  download [run-id]         Download compiled artifacts from GitHub Actions to ./artifacts/"
    echo ""
    echo "CircleCI Commands:"
    echo "  circle-build [target]     Trigger remote build on CircleCI (default: recoveryimage)"
    echo "                            Targets: recoveryimage | bootimage | rom | sepolicy"
    echo "                            Example: ./crb circle-build recoveryimage"
    echo "  circle-status             List recent CircleCI pipeline runs"
    echo "  circle-download <job_id>  Download compiled flashable artifacts from CircleCI job"
    echo ""
    echo "Phone Flashing Commands (From Xiaomi OS -> LineageOS via Fastboot & Recovery):"
    echo "  flash-boot                Flash boot.img, vendor_boot.img, and dtbo.img via Fastboot"
    echo "  flash-recovery            Flash recovery.img via Fastboot"
    echo "  flash-all                 Flash boot, vendor_boot, dtbo, and recovery, then reboot to recovery"
    echo "  sideload                  Sideload the flashable LineageOS zip via Recovery ADB sideload"
    echo "  instructions              Display complete step-by-step flashing guide from Xiaomi OS"
    echo ""
}

function get_circle_token() {
    echo "${CIRCLE_TOKEN:-${CIRCLECI_TOKEN:-}}"
}

function ensure_circle_token() {
    local token=$(get_circle_token)
    if [ -z "$token" ]; then
        log_err "CircleCI token not found."
        echo -e "  To authenticate with CircleCI API, generate a Personal API Token at:"
        echo -e "    ${CYAN}https://app.circleci.com/settings/user/tokens${NC}"
        echo -e "  Then export it in your shell or ~/.bashrc:"
        echo -e "    ${YELLOW}export CIRCLE_TOKEN=\"your_token_here\"${NC}"
        return 1
    fi
    return 0
}

function do_circle_build() {
    local target="${1:-recoveryimage}"
    local cur_branch=$(git branch --show-current)

    # Check for uncommitted changes to configuration
    if [ -n "$(git status --porcelain .circleci/config.yml crb)" ]; then
        log_info "Committing local CI configuration changes before triggering remote build..."
        git add .circleci/config.yml crb
        git commit -m "Configure CircleCI build for Xiaomi zorn ($target)" || true
    fi

    # Check if there are unpushed commits
    local unpushed=$(git log origin/"$cur_branch"..HEAD 2>/dev/null | wc -l)
    if [ "$unpushed" -gt 0 ]; then
        log_info "Pushing latest commits to origin/$cur_branch so CircleCI builds updated configuration..."
        git push origin "$cur_branch"
    fi

    if command -v circleci &>/dev/null && circleci auth me &>/dev/null; then
        log_info "Triggering CircleCI pipeline via circleci CLI (target: '$target', branch: '$cur_branch')..."
        circleci run trigger --project "$CIRCLE_PROJECT_SLUG" --branch "$cur_branch" --parameter target="$target"
        echo ""
        log_info "To check pipeline status: ./crb circle-status"
    else
        local token=$(get_circle_token)
        if [ -n "$token" ]; then
            log_info "Triggering CircleCI pipeline for target: '$target' on branch: '$cur_branch' via API..."
            local response=$(curl -s -X POST "https://circleci.com/api/v2/project/$CIRCLE_PROJECT_SLUG/pipeline" \
                -H "Circle-Token: $token" \
                -H "Content-Type: application/json" \
                -d "{\"branch\": \"$cur_branch\", \"parameters\": {\"target\": \"$target\"}}")
            
            local pipeline_id=$(echo "$response" | jq -r '.id // empty')
            local pipeline_num=$(echo "$response" | jq -r '.number // empty')
            
            if [ -n "$pipeline_id" ]; then
                log_success "CircleCI pipeline #$pipeline_num triggered successfully! (ID: $pipeline_id)"
                echo -e "Dashboard: ${CYAN}https://app.circleci.com/pipelines/$CIRCLE_PROJECT_SLUG/$pipeline_num${NC}"
                echo ""
                log_info "To check pipeline status: ./crb circle-status"
            else
                log_err "Failed to trigger CircleCI pipeline: $response"
            fi
        else
            log_warn "CircleCI CLI is not logged in ('circleci auth login') and no CIRCLE_TOKEN detected."
            log_info "Pushing current branch '$cur_branch' to trigger CircleCI pipeline automatically..."
            git push origin "$cur_branch"
            log_success "Pushed to origin/$cur_branch! CircleCI pipeline automatically started for target: $target"
            echo -e "Dashboard: ${CYAN}https://app.circleci.com/pipelines/$CIRCLE_PROJECT_SLUG${NC}"
            echo ""
            log_info "Tip: Run 'circleci auth login' to authenticate the CLI directly."
        fi
    fi
}

function do_circle_status() {
    if command -v circleci &>/dev/null && circleci auth me &>/dev/null; then
        log_info "Fetching recent CircleCI runs via circleci CLI..."
        circleci run list --project "$CIRCLE_PROJECT_SLUG" || true
    else
        local token=$(get_circle_token)
        if ensure_circle_token; then
            log_info "Fetching recent CircleCI pipelines for $CIRCLE_PROJECT_SLUG..."
            curl -s "https://circleci.com/api/v2/project/$CIRCLE_PROJECT_SLUG/pipeline" \
                -H "Circle-Token: $token" | jq -r '.items[0:8][] | "Pipeline #\(.number) | State: \(.state) | Branch: \(.vcs.branch // "N/A") | Created: \(.created_at) | ID: \(.id)"' || true
        fi
    fi
}

function do_circle_download() {
    local job_id="$1"
    if [ -z "$job_id" ]; then
        log_err "Usage: ./crb circle-download <job_id>"
        echo "You can find the job UUID or number in the CircleCI dashboard or pipeline view."
        exit 1
    fi
    mkdir -p "$ARTIFACTS_DIR"
    if command -v circleci &>/dev/null && circleci auth me &>/dev/null; then
        log_info "Downloading artifacts for Job $job_id via circleci CLI..."
        circleci artifact "$job_id" --output "$ARTIFACTS_DIR"
    else
        local token=$(get_circle_token)
        log_info "Fetching artifact URLs for CircleCI Job $job_id..."
        local auth_header=()
        if [ -n "$token" ]; then
            auth_header=(-H "Circle-Token: $token")
        fi
        
        local artifacts_json=$(curl -s "${auth_header[@]}" "https://circleci.com/api/v2/project/$CIRCLE_PROJECT_SLUG/$job_id/artifacts")
        local urls=$(echo "$artifacts_json" | jq -r '.items[]?.url // empty')
        
        if [ -z "$urls" ]; then
            log_err "No artifacts found for Job $job_id. Response: $artifacts_json"
            exit 1
        fi
        
        for url in $urls; do
            local filename=$(basename "$url")
            log_info "Downloading $filename..."
            curl -sSL "${auth_header[@]}" "$url" -o "$ARTIFACTS_DIR/$filename"
        done
    fi
    log_success "Downloaded CircleCI artifacts into ./artifacts/:"
    find "$ARTIFACTS_DIR" -type f -exec ls -lh {} +
}

function ensure_gh_auth() {
    if ! command -v gh &> /dev/null; then
        log_err "GitHub CLI ('gh') is not installed. Please install it first."
        exit 1
    fi
    if ! gh auth status &> /dev/null; then
        log_err "GitHub CLI is not logged in. Run 'gh auth login' first."
        exit 1
    fi
}

function ensure_fastboot_device() {
    if ! command -v fastboot &> /dev/null; then
        log_err "fastboot command not found. Please install android-tools-fastboot."
        exit 1
    fi
    log_info "Detecting fastboot device..."
    local fb_dev=$(fastboot devices | awk '{print $1}')
    if [ -z "$fb_dev" ]; then
        log_err "No device found in Fastboot mode! Put phone in Fastboot (Hold Volume Down + Power) and connect USB."
        exit 1
    fi
    log_success "Found Fastboot device: $fb_dev"
}

function print_instructions() {
    echo -e "${CYAN}========================================================================${NC}"
    echo -e "${GREEN}  Step-by-Step Flashing Guide: Xiaomi OS (HyperOS) -> LineageOS 24.0   ${NC}"
    echo -e "${CYAN}========================================================================${NC}"
    echo ""
    echo "1. PREREQUISITES:"
    echo "   - Bootloader MUST be officially unlocked on your Xiaomi zorn."
    echo "   - Backup all important user data (format data will wipe the phone)."
    echo ""
    echo "2. BUILD THE FLASHABLE ROM:"
    echo "   $ ./crb build rom"
    echo "   (Track progress with './crb logs', check runs with './crb status')"
    echo ""
    echo "3. DOWNLOAD ARTIFACTS:"
    echo "   $ ./crb download"
    echo "   This downloads: boot.img, vendor_boot.img, dtbo.img, recovery.img, and lineage-*.zip"
    echo ""
    echo "4. FLASH VIA FASTBOOT:"
    echo "   - Reboot phone into Fastboot mode: Hold Volume Down + Power."
    echo "   - Connect USB-C cable to your PC."
    echo "   $ ./crb flash-all"
    echo "   (This flashes boot, vendor_boot, dtbo, and recovery, then reboots into Lineage Recovery)"
    echo ""
    echo "5. FACTORY RESET & SIDELOAD IN RECOVERY:"
    echo "   - In Lineage Recovery on phone screen:"
    echo "       Select 'Factory Reset' -> 'Format data/factory reset' -> Confirm"
    echo "   - Return to main menu, select 'Apply update' -> 'Apply from ADB'"
    echo "   - Run sideload command on PC:"
    echo "       $ ./crb sideload"
    echo "   - Once sideload reaches 100% (or step 2/2 finishes with total xfer 1.00x):"
    echo "       Select 'Reboot system now'"
    echo ""
    echo -e "${CYAN}========================================================================${NC}"
}

COMMAND="$1"
shift || true

case "$COMMAND" in
    build)
        TARGET="${1:-rom}"
        ensure_gh_auth
        
        log_info "Triggering GitHub Actions cloud build for target: '$TARGET'..."
        gh workflow run "$WORKFLOW_FILE" -f target="$TARGET"
        
        log_success "Cloud build triggered!"
        sleep 3
        gh run list --workflow="$WORKFLOW_FILE" --limit 3
        echo ""
        log_info "To stream build logs in real-time, run: ./crb logs"
        log_info "To check build status, run: ./crb status"
        ;;

    status)
        ensure_gh_auth
        log_info "Recent GitHub Actions build runs:"
        gh run list --workflow="$WORKFLOW_FILE" --limit 8
        ;;

    watch)
        ensure_gh_auth
        RUN_ID="$1"
        if [ -z "$RUN_ID" ]; then
            RUN_ID=$(gh run list --workflow="$WORKFLOW_FILE" --limit 1 --json databaseId -q '.[0].databaseId')
        fi
        log_info "Watching live progress for Run ID: $RUN_ID..."
        gh run watch "$RUN_ID"
        ;;

    logs)
        ensure_gh_auth
        RUN_ID="$1"
        if [ -z "$RUN_ID" ]; then
            RUN_ID=$(gh run list --workflow="$WORKFLOW_FILE" --limit 1 --json databaseId -q '.[0].databaseId')
        fi
        log_info "Fetching logs for Run ID: $RUN_ID..."
        gh run view "$RUN_ID" --log 2>/dev/null || {
            log_warn "Run is currently in progress. Switching to live watch..."
            gh run watch "$RUN_ID"
        }
        ;;

    download)
        ensure_gh_auth
        RUN_ID="$1"
        mkdir -p "$ARTIFACTS_DIR"
        if [ -z "$RUN_ID" ]; then
            RUN_ID=$(gh run list --workflow="$WORKFLOW_FILE" --limit 1 --json databaseId -q '.[0].databaseId')
        fi
        log_info "Downloading compiled flashable artifacts for Run ID: $RUN_ID..."
        gh run download "$RUN_ID" --dir "$ARTIFACTS_DIR"
        log_success "Downloaded flashable artifacts into ./artifacts/:"
        find "$ARTIFACTS_DIR" -type f -exec ls -lh {} +
        ;;

    circle-build|cci-build)
        do_circle_build "$1"
        ;;

    circle-status|cci-status)
        do_circle_status
        ;;

    circle-download|cci-download)
        do_circle_download "$1"
        ;;

    flash-boot)
        ensure_fastboot_device
        BOOT_IMG=$(find "$ARTIFACTS_DIR" -name "boot.img" | head -n 1)
        VENDOR_BOOT_IMG=$(find "$ARTIFACTS_DIR" -name "vendor_boot.img" | head -n 1)
        DTBO_IMG=$(find "$ARTIFACTS_DIR" -name "dtbo.img" | head -n 1)

        if [ -z "$BOOT_IMG" ] || [ ! -f "$BOOT_IMG" ]; then
            log_err "boot.img not found in ./artifacts/. Run './crb download' first."
            exit 1
        fi

        log_info "Flashing boot.img -> boot partition..."
        fastboot flash boot "$BOOT_IMG"

        if [ -n "$VENDOR_BOOT_IMG" ] && [ -f "$VENDOR_BOOT_IMG" ]; then
            log_info "Flashing vendor_boot.img -> vendor_boot partition..."
            fastboot flash vendor_boot "$VENDOR_BOOT_IMG"
        fi

        if [ -n "$DTBO_IMG" ] && [ -f "$DTBO_IMG" ]; then
            log_info "Flashing dtbo.img -> dtbo partition..."
            fastboot flash dtbo "$DTBO_IMG"
        fi

        log_success "Boot images flashed successfully!"
        ;;

    flash-recovery)
        ensure_fastboot_device
        RECOVERY_IMG=$(find "$ARTIFACTS_DIR" -name "recovery.img" | head -n 1)

        if [ -z "$RECOVERY_IMG" ] || [ ! -f "$RECOVERY_IMG" ]; then
            log_err "recovery.img not found in ./artifacts/. Run './crb download' first."
            exit 1
        fi

        log_info "Flashing recovery.img -> recovery partition..."
        fastboot flash recovery "$RECOVERY_IMG"
        log_success "Recovery flashed successfully!"
        ;;

    flash-all)
        ensure_fastboot_device
        BOOT_IMG=$(find "$ARTIFACTS_DIR" -name "boot.img" | head -n 1)
        VENDOR_BOOT_IMG=$(find "$ARTIFACTS_DIR" -name "vendor_boot.img" | head -n 1)
        DTBO_IMG=$(find "$ARTIFACTS_DIR" -name "dtbo.img" | head -n 1)
        RECOVERY_IMG=$(find "$ARTIFACTS_DIR" -name "recovery.img" | head -n 1)

        if [ -z "$BOOT_IMG" ] || [ -z "$RECOVERY_IMG" ]; then
            log_err "Required images (boot.img or recovery.img) missing in ./artifacts/. Run './crb download' first."
            exit 1
        fi

        log_info "Flashing boot.img..."
        fastboot flash boot "$BOOT_IMG"

        if [ -n "$VENDOR_BOOT_IMG" ] && [ -f "$VENDOR_BOOT_IMG" ]; then
            log_info "Flashing vendor_boot.img..."
            fastboot flash vendor_boot "$VENDOR_BOOT_IMG"
        fi

        if [ -n "$DTBO_IMG" ] && [ -f "$DTBO_IMG" ]; then
            log_info "Flashing dtbo.img..."
            fastboot flash dtbo "$DTBO_IMG"
        fi

        log_info "Flashing recovery.img..."
        fastboot flash recovery "$RECOVERY_IMG"

        log_success "All boot and recovery partitions flashed successfully!"
        log_info "Rebooting device into Lineage Recovery in 3 seconds..."
        sleep 3
        fastboot reboot recovery
        log_success "Phone is booting into Recovery. Perform 'Factory Reset', select 'Apply from ADB', then run './crb sideload'."
        ;;

    sideload)
        if ! command -v adb &> /dev/null; then
            log_err "adb command not found. Please install android-tools-adb."
            exit 1
        fi
        ZIP_FILE=$(find "$ARTIFACTS_DIR" -name "lineage-*.zip" | head -n 1)
        if [ -z "$ZIP_FILE" ] || [ ! -f "$ZIP_FILE" ]; then
            log_err "lineage-*.zip not found in ./artifacts/. Run './crb download' first."
            exit 1
        fi
        log_info "Waiting for device in ADB Sideload mode..."
        adb wait-for-sideload
        log_info "Sideloading $ZIP_FILE..."
        adb sideload "$ZIP_FILE"
        log_success "Sideload completed! You can now reboot system from Recovery."
        ;;

    instructions)
        print_instructions
        ;;

    *)
        print_usage
        ;;
esac
