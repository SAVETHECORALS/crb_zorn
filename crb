#!/usr/bin/env bash
#
# crb - Cloud Remote Builder & Flashing CLI for Xiaomi zorn (LineageOS 24.0 / Android 17)
#

set -e

WORKFLOW_FILE="build.yml"
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ARTIFACTS_DIR="$PROJECT_DIR/artifacts"

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

function log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

function log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

function log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

function log_err() {
    echo -e "${RED}[ERROR]${NC} $1"
}

function print_usage() {
    echo -e "${GREEN}crb - Xiaomi zorn (Android 17) Cloud Remote Builder & Fastboot Flasher${NC}"
    echo ""
    echo "Usage: ./crb <command> [arguments]"
    echo ""
    echo "Cloud CI Commands (GitHub Actions):"
    echo "  build [target]            Trigger remote cloud build on GitHub Actions (default: rom)"
    echo "                            Targets: rom (full flashable zip) | bootimage | recoveryimage | sepolicy"
    echo "                            Example: ./crb build rom"
    echo "                            Example: ./crb build bootimage"
    echo "  status                    List recent cloud build runs and their status"
    echo "  logs [run-id]             Stream/view workflow build logs"
    echo "  download [run-id]         Download compiled flashable artifacts from cloud to ./artifacts/"
    echo ""
    echo "Phone Flashing Commands (From Xiaomi OS -> LineageOS via Fastboot & Recovery):"
    echo "  flash-boot                Flash boot.img, vendor_boot.img, and dtbo.img via Fastboot"
    echo "  flash-recovery            Flash recovery.img via Fastboot"
    echo "  flash-all                 Flash boot, vendor_boot, dtbo, and recovery, then reboot to recovery"
    echo "  sideload                  Sideload the flashable LineageOS zip via Recovery ADB sideload"
    echo "  instructions              Display complete step-by-step flashing guide from Xiaomi OS"
    echo ""
}

function ensure_gh_auth() {
    if ! command -v gh &> /dev/null; then
        log_err "GitHub CLI ('gh') is not installed. Please install it first."
        exit 1
    fi
    if ! gh auth status &> /dev/null; then
        log_err "GitHub CLI is not logged in. Run 'gh auth login' first."
        exit 1
    fi
}

function ensure_fastboot_device() {
    if ! command -v fastboot &> /dev/null; then
        log_err "fastboot command not found. Please install android-tools-fastboot."
        exit 1
    fi
    log_info "Detecting fastboot device..."
    local fb_dev=$(fastboot devices | awk '{print $1}')
    if [ -z "$fb_dev" ]; then
        log_err "No device found in Fastboot mode! Put phone in Fastboot (Hold Volume Down + Power) and connect USB."
        exit 1
    fi
    log_success "Found Fastboot device: $fb_dev"
}

function print_instructions() {
    echo -e "${CYAN}========================================================================${NC}"
    echo -e "${GREEN}  Step-by-Step Flashing Guide: Xiaomi OS (HyperOS) -> LineageOS 24.0   ${NC}"
    echo -e "${CYAN}========================================================================${NC}"
    echo ""
    echo "1. PREREQUISITES:"
    echo "   - Bootloader MUST be officially unlocked on your Xiaomi zorn."
    echo "   - Backup all important user data (format data will wipe the phone)."
    echo ""
    echo "2. BUILD THE FLASHABLE ROM:"
    echo "   $ ./crb build rom"
    echo "   (Track progress with './crb logs', check runs with './crb status')"
    echo ""
    echo "3. DOWNLOAD ARTIFACTS:"
    echo "   $ ./crb download"
    echo "   This downloads: boot.img, vendor_boot.img, dtbo.img, recovery.img, and lineage-*.zip"
    echo ""
    echo "4. FLASH VIA FASTBOOT:"
    echo "   - Reboot phone into Fastboot mode: Hold Volume Down + Power."
    echo "   - Connect USB-C cable to your PC."
    echo "   $ ./crb flash-all"
    echo "   (This flashes boot, vendor_boot, dtbo, and recovery, then reboots into Lineage Recovery)"
    echo ""
    echo "5. FACTORY RESET & SIDELOAD IN RECOVERY:"
    echo "   - In Lineage Recovery on phone screen:"
    echo "       Select 'Factory Reset' -> 'Format data/factory reset' -> Confirm"
    echo "   - Return to main menu, select 'Apply update' -> 'Apply from ADB'"
    echo "   - Run sideload command on PC:"
    echo "       $ ./crb sideload"
    echo "   - Once sideload reaches 100% (or step 2/2 finishes with total xfer 1.00x):"
    echo "       Select 'Reboot system now'"
    echo ""
    echo -e "${CYAN}========================================================================${NC}"
}

COMMAND="$1"
shift || true

case "$COMMAND" in
    build)
        TARGET="${1:-rom}"
        ensure_gh_auth
        
        log_info "Triggering GitHub Actions cloud build for target: '$TARGET'..."
        gh workflow run "$WORKFLOW_FILE" -f target="$TARGET"
        
        log_success "Cloud build triggered!"
        sleep 3
        gh run list --workflow="$WORKFLOW_FILE" --limit 3
        echo ""
        log_info "To stream build logs in real-time, run: ./crb logs"
        log_info "To check build status, run: ./crb status"
        ;;

    status)
        ensure_gh_auth
        log_info "Recent GitHub Actions build runs:"
        gh run list --workflow="$WORKFLOW_FILE" --limit 8
        ;;

    logs)
        ensure_gh_auth
        RUN_ID="$1"
        if [ -z "$RUN_ID" ]; then
            RUN_ID=$(gh run list --workflow="$WORKFLOW_FILE" --limit 1 --json databaseId -q '.[0].databaseId')
        fi
        log_info "Streaming logs for Run ID: $RUN_ID..."
        gh run view "$RUN_ID" --log
        ;;

    download)
        ensure_gh_auth
        RUN_ID="$1"
        mkdir -p "$ARTIFACTS_DIR"
        if [ -z "$RUN_ID" ]; then
            RUN_ID=$(gh run list --workflow="$WORKFLOW_FILE" --limit 1 --json databaseId -q '.[0].databaseId')
        fi
        log_info "Downloading compiled flashable artifacts for Run ID: $RUN_ID..."
        gh run download "$RUN_ID" --dir "$ARTIFACTS_DIR"
        log_success "Downloaded flashable artifacts into ./artifacts/:"
        find "$ARTIFACTS_DIR" -type f -exec ls -lh {} +
        ;;

    flash-boot)
        ensure_fastboot_device
        BOOT_IMG=$(find "$ARTIFACTS_DIR" -name "boot.img" | head -n 1)
        VENDOR_BOOT_IMG=$(find "$ARTIFACTS_DIR" -name "vendor_boot.img" | head -n 1)
        DTBO_IMG=$(find "$ARTIFACTS_DIR" -name "dtbo.img" | head -n 1)

        if [ -z "$BOOT_IMG" ] || [ ! -f "$BOOT_IMG" ]; then
            log_err "boot.img not found in ./artifacts/. Run './crb download' first."
            exit 1
        fi

        log_info "Flashing boot.img -> boot partition..."
        fastboot flash boot "$BOOT_IMG"

        if [ -n "$VENDOR_BOOT_IMG" ] && [ -f "$VENDOR_BOOT_IMG" ]; then
            log_info "Flashing vendor_boot.img -> vendor_boot partition..."
            fastboot flash vendor_boot "$VENDOR_BOOT_IMG"
        fi

        if [ -n "$DTBO_IMG" ] && [ -f "$DTBO_IMG" ]; then
            log_info "Flashing dtbo.img -> dtbo partition..."
            fastboot flash dtbo "$DTBO_IMG"
        fi

        log_success "Boot images flashed successfully!"
        ;;

    flash-recovery)
        ensure_fastboot_device
        RECOVERY_IMG=$(find "$ARTIFACTS_DIR" -name "recovery.img" | head -n 1)

        if [ -z "$RECOVERY_IMG" ] || [ ! -f "$RECOVERY_IMG" ]; then
            log_err "recovery.img not found in ./artifacts/. Run './crb download' first."
            exit 1
        fi

        log_info "Flashing recovery.img -> recovery partition..."
        fastboot flash recovery "$RECOVERY_IMG"
        log_success "Recovery flashed successfully!"
        ;;

    flash-all)
        ensure_fastboot_device
        BOOT_IMG=$(find "$ARTIFACTS_DIR" -name "boot.img" | head -n 1)
        VENDOR_BOOT_IMG=$(find "$ARTIFACTS_DIR" -name "vendor_boot.img" | head -n 1)
        DTBO_IMG=$(find "$ARTIFACTS_DIR" -name "dtbo.img" | head -n 1)
        RECOVERY_IMG=$(find "$ARTIFACTS_DIR" -name "recovery.img" | head -n 1)

        if [ -z "$BOOT_IMG" ] || [ -z "$RECOVERY_IMG" ]; then
            log_err "Required images (boot.img or recovery.img) missing in ./artifacts/. Run './crb download' first."
            exit 1
        fi

        log_info "Flashing boot.img..."
        fastboot flash boot "$BOOT_IMG"

        if [ -n "$VENDOR_BOOT_IMG" ] && [ -f "$VENDOR_BOOT_IMG" ]; then
            log_info "Flashing vendor_boot.img..."
            fastboot flash vendor_boot "$VENDOR_BOOT_IMG"
        fi

        if [ -n "$DTBO_IMG" ] && [ -f "$DTBO_IMG" ]; then
            log_info "Flashing dtbo.img..."
            fastboot flash dtbo "$DTBO_IMG"
        fi

        log_info "Flashing recovery.img..."
        fastboot flash recovery "$RECOVERY_IMG"

        log_success "All boot and recovery partitions flashed successfully!"
        log_info "Rebooting device into Lineage Recovery in 3 seconds..."
        sleep 3
        fastboot reboot recovery
        log_success "Phone is booting into Recovery. Perform 'Factory Reset', select 'Apply from ADB', then run './crb sideload'."
        ;;

    sideload)
        if ! command -v adb &> /dev/null; then
            log_err "adb command not found. Please install android-tools-adb."
            exit 1
        fi
        ZIP_FILE=$(find "$ARTIFACTS_DIR" -name "lineage-*.zip" | head -n 1)
        if [ -z "$ZIP_FILE" ] || [ ! -f "$ZIP_FILE" ]; then
            log_err "lineage-*.zip not found in ./artifacts/. Run './crb download' first."
            exit 1
        fi
        log_info "Waiting for device in ADB Sideload mode..."
        adb wait-for-sideload
        log_info "Sideloading $ZIP_FILE..."
        adb sideload "$ZIP_FILE"
        log_success "Sideload completed! You can now reboot system from Recovery."
        ;;

    instructions)
        print_instructions
        ;;

    *)
        print_usage
        ;;
esac
